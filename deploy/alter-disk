#!/usr/bin/python3 -I
"""Mount/unmount only external partitions discovered by lsblk."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys

try:
    data = json.loads(sys.stdin.read(4096))
    if data.get("action") == "mount" and Path("/var/lib/alter-ntfs-maintenance/active").exists():
        raise ValueError("Storage maintenance is active; mounting is temporarily disabled")
    tree = json.loads(subprocess.check_output(
        ["/usr/bin/lsblk", "-J", "-o", "NAME,PATH,TRAN,FSTYPE,UUID,MOUNTPOINTS"], text=True))
    def candidates(items, tran=None):
        for item in items:
            transport = item.get("tran") or tran
            if (transport == "usb" or item["name"].startswith("nvme")) and item.get("fstype"):
                yield item
            yield from candidates(item.get("children", []), transport)
    device = next((d for d in candidates(tree["blockdevices"]) if d["path"] == data["device"]), None)
    if not device or data["action"] not in {"mount", "unmount"}:
        raise ValueError("External partition and mount/unmount action required")
    if data["action"] == "mount":
        if any(device.get("mountpoints", [])):
            raise ValueError("Already mounted")
        identifier = device.get("uuid") or ""
        if not re.fullmatch(r"[A-Za-z0-9-]+", identifier):
            raise ValueError("Invalid filesystem UUID")
        base = Path("/mnt/alter")
        base.mkdir(mode=0o755, exist_ok=True)
        target = base / identifier
        target.mkdir(mode=0o755, exist_ok=True)
        for folder in (base, target):
            if folder.is_symlink() or folder.stat().st_uid != 0 or folder.stat().st_mode & 0o022:
                raise ValueError("Mount directories must be root-owned and not writable by others")
        if os.path.ismount(target):
            raise ValueError("Mount target is already occupied")
        os.chmod(base, 0o755)
        os.chmod(target, 0o755)
        options = "nosuid,nodev"
        if device["fstype"] in {"vfat", "exfat", "ntfs"}:
            options += ",uid=1000,gid=1000"
        if device["fstype"] == "vfat":
            options += ",utf8=1"
        args = ["/usr/bin/mount"]
        if device["fstype"] == "ntfs":
            # 이 장비에서 확인된 NTFS3 압축 읽기 교착을 피한다.
            args += ["-t", "ntfs-3g"]
            options += ",nocompression"
        args += ["-o", options, "--", device["path"], str(target)]
    else:
        args = ["/usr/bin/umount", "--", device["path"]]
    result = subprocess.run(args, capture_output=True, text=True, timeout=30)
    if result.returncode:
        raise RuntimeError(result.stderr.strip())
    print(result.stdout.strip() or data["action"] + ": " + device["path"])
except Exception as exc:
    print(str(exc), file=sys.stderr)
    sys.exit(1)
