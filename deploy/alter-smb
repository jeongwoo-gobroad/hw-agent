#!/usr/bin/python3 -I
"""Root-owned, fixed-scope Samba configuration helper."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

def main():
    data = json.loads(sys.stdin.read(8192))
    name = data["name"]
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,40}", name):
        raise ValueError("Invalid share name")
    path = Path(data["path"]).resolve(strict=True)
    if any(c in str(path) for c in "\n\r%[]"):
        raise ValueError("Invalid path")
    tree = json.loads(subprocess.check_output(
        ["/usr/bin/lsblk", "-J", "-o", "NAME,TRAN,MOUNTPOINTS"], text=True))
    def mounts(items, transport=None):
        for item in items:
            tran = item.get("tran") or transport
            if tran == "usb" or item["name"].startswith("nvme"):
                yield from (m for m in item.get("mountpoints", []) if m and m != "/")
            yield from mounts(item.get("children", []), tran)
    if not path.is_dir() or not any(path.is_relative_to(Path(m).resolve()) for m in mounts(tree["blockdevices"])):
        raise ValueError("Only mounted external storage can be shared")
    folder = Path("/etc/samba/alter.d")
    folder.mkdir(mode=0o755, exist_ok=True)
    target = folder / (name + ".conf")
    if data["action"] == "remove":
        target.unlink(missing_ok=True)
    elif data["action"] == "set":
        text = (f"[Alter-{name}]\npath = {path}\nvalid users = jeongwoo\n"
                f"read only = {'yes' if data.get('readonly', True) else 'no'}\n"
                "guest ok = no\nfollow symlinks = no\nwide links = no\n"
                "force user = jeongwoo\ncreate mask = 0600\ndirectory mask = 0700\n")
        with tempfile.NamedTemporaryFile(mode="w", dir=folder, delete=False) as f:
            f.write(text)
            temp = Path(f.name)
        subprocess.run(["/usr/bin/testparm", "-s", str(temp)], check=True, capture_output=True)
        os.chmod(temp, 0o644)
        temp.replace(target)
    else:
        raise ValueError("Unknown action")
    includes = "".join(f"include = {p}\n" for p in sorted(folder.glob("*.conf")))
    Path("/etc/samba/alter-shares.conf").write_text(includes)
    subprocess.run(["/usr/bin/testparm", "-s"], check=True, capture_output=True)
    subprocess.run(["/usr/bin/systemctl", "reload", "smbd"], check=True)
    print(f"Alter-{name}: configuration applied")

if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
