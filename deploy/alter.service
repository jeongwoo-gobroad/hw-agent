[Unit]
Description=Alter local personal agent
After=network-online.target
Wants=network-online.target

[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/hw-agent
Environment=PYTHONPATH=/home/pi/hw-agent/src
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=2
ExecStart=/home/pi/hw-agent/.venv/bin/uvicorn hw_agent.app:app --host 0.0.0.0 --port 8080 --workers 1
Restart=on-failure
RestartSec=5
UMask=0077
MemoryMax=1200M
MemorySwapMax=256M
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
