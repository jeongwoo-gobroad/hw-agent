[Unit]
StartLimitIntervalSec=0
Description=Alter local personal agent
After=network-online.target
Wants=network-online.target

[Service]
User=jeongwoo
Group=jeongwoo
WorkingDirectory=/home/jeongwoo/hw-agent
Environment=PYTHONPATH=/home/jeongwoo/hw-agent/src
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=2
ExecStart=/home/jeongwoo/hw-agent/.venv/bin/uvicorn hw_agent.app:app --host 0.0.0.0 --port 8080 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
MemoryMax=1200M
MemorySwapMax=256M
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
