[Unit]
Description=Restore Alter registered storage and verify startup connections
After=network-online.target alter.service alter-llm.service alter-ngrok.service alter-photos.service
Wants=network-online.target alter.service alter-photos.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@
Environment=PYTHONPATH=@ROOT@/src
ExecStart=@ROOT@/.venv/bin/python scripts/recover.py
TimeoutStartSec=420
RestartPreventExitStatus=2
Restart=on-failure
RestartSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
