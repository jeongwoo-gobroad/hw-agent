msgid "2GiB 초과 영상은 다운로드로 확인하세요."
msgstr "Download the original to view videos larger than 2GiB."

msgid "Flow가 실행 중이거나 쿨다운 중입니다."
msgstr "This Flow is running or cooling down."

msgid "Flow를 찾을 수 없습니다."
msgstr "Flow not found."

msgid "Flow에는 1~20단계가 필요합니다."
msgstr "A Flow needs 1–20 steps."

msgid "OAuth 상태 검증 실패. 대시보드에서 다시 연결하세요."
msgstr "OAuth state verification failed. Reconnect from the dashboard."

msgid "OAuth 클라이언트와 HTTPS 콜백 주소를 먼저 등록하세요."
msgstr "Register your OAuth client and HTTPS callback first."

#, python-format
msgid "SmartThings API 오류 (%(v0)s)"
msgstr "SmartThings API error (%(v0)s)"

msgid "SmartThings OAuth 앱 등록이 필요합니다."
msgstr "Register a SmartThings OAuth app first."

msgid "SmartThings 연결 실패"
msgstr "SmartThings connection failed"

msgid "SmartThings 연결이 필요합니다."
msgstr "Connect SmartThings first."

msgid "SmartThings 요청 제한: 잠시 후 다시 시도하세요."
msgstr "SmartThings rate limit reached. Try again later."

msgid "SmartThings 인증 갱신에 실패했습니다. 다시 연결하세요."
msgstr "SmartThings token refresh failed. Please reconnect."

msgid "SmartThings 인증 만료: PAT 교체 또는 OAuth 재인증이 필요합니다."
msgstr "SmartThings credentials expired. Replace the PAT or reconnect with OAuth."

msgid "SmartThings 토큰 교환에 실패했습니다. 다시 연결하세요."
msgstr "SmartThings token exchange failed. Please reconnect."

msgid "SmartThings에서 삼성 계정을 연결하세요."
msgstr "Connect your Samsung account in SmartThings."

msgid "감지 시간과 반복 설정을 확인하세요."
msgstr "Check the detection timing and repeat settings."

msgid "값은 0~100이어야 합니다."
msgstr "The value must be between 0 and 100."

msgid "기기 단계 필드가 부족합니다."
msgstr "Required device step fields are missing."

msgid "기기가 이 capability를 지원하지 않습니다."
msgstr "This device does not support that capability."

msgid "기기를 찾을 수 없습니다."
msgstr "Device not found."

msgid "날짜 범위 또는 페이지 값이 올바르지 않습니다."
msgstr "Invalid date range or page value."

msgid "녹화 경로가 허용 폴더 밖에 있습니다."
msgstr "The recording path is outside the allowed folder."

msgid "녹화 또는 색인 종료 후 시도하세요."
msgstr "Wait for recording or indexing to finish."

msgid "녹화 시작에는 512MiB 이상 여유 공간이 필요합니다."
msgstr "Recording requires at least 512MiB of free space."

msgid "녹화를 중지한 뒤 카메라 방향을 변경하세요."
msgstr "Stop recording before changing camera orientation."

msgid "다른 답변을 생성 중입니다."
msgstr "Another response is being generated."

msgid "다른 음성을 처리 중입니다. 잠시 후 다시 시도하세요."
msgstr "Another audio request is being processed. Please wait."

msgid "대화를 찾을 수 없습니다."
msgstr "Conversation not found."

msgid "동일한 파일시스템 UUID의 장치가 여러 개입니다. 복제 드라이브를 분리하세요."
msgstr "Multiple devices have the same filesystem UUID. Disconnect the cloned drive."

msgid "등록 폴더 밖의 경로입니다."
msgstr "This path is outside the registered folder."

msgid "등록 폴더 밖입니다."
msgstr "Outside the registered folder."

msgid "등록 폴더 안의 일반 경로만 열 수 있습니다."
msgstr "Only regular paths inside registered folders can be opened."

msgid "등록된 색인 폴더가 아닙니다."
msgstr "This is not a registered index folder."

msgid "등록된 저장 폴더를 선택하세요."
msgstr "Choose a registered recording folder."

msgid "등록된 폴더가 현재 드라이브에 없습니다."
msgstr "The registered folder is missing from the current drive."

msgid "등록이 해제된 사진 폴더입니다."
msgstr "This photo folder is no longer registered."

msgid "등록이 해제된 폴더입니다."
msgstr "This folder is no longer registered."

#, python-format
msgid "로그인 실패 %(v0)s회로 %(v1)s분 차단됐습니다."
msgstr "Blocked for %(v1)s minutes after %(v0)s failed login attempts."

msgid "로그인 연결이 만료되었습니다. 대시보드에서 다시 시작하세요."
msgstr "This login link expired. Start again from the dashboard."

#, python-format
msgid "로그인이 일시 차단됐습니다. 약 %(v0)s분 후 다시 시도하세요."
msgstr "Login is temporarily blocked. Try again in about %(v0)s minutes."

msgid "로그인이 필요합니다."
msgstr "Sign in to continue."

msgid "미리보기 준비 중입니다."
msgstr "Preparing preview."

msgid "사람을 찾을 수 없습니다."
msgstr "Person not found."

msgid "사진 드라이브가 연결되지 않았습니다."
msgstr "The photo drive is disconnected."

msgid "사진 폴더 경계를 벗어났습니다."
msgstr "Outside the photo folder boundary."

msgid "사진 폴더 밖의 파일입니다."
msgstr "This file is outside the photo folder."

msgid "사진 폴더를 선택하세요."
msgstr "Choose a photo folder."

msgid "사진을 찾을 수 없습니다."
msgstr "Photo not found."

msgid "색온도는 2000~6500K이어야 합니다."
msgstr "Color temperature must be between 2000 and 6500K."

msgid "숨김 폴더는 등록할 수 없습니다."
msgstr "Hidden folders cannot be registered."

msgid "실행 중인 Flow입니다."
msgstr "This Flow is running."

msgid "심볼릭 링크는 열지 않습니다."
msgstr "Symbolic links cannot be opened."

msgid "심볼릭 링크는 처리하지 않습니다."
msgstr "Symbolic links are not processed."

msgid "심볼릭 링크는 탐색하지 않습니다."
msgstr "Symbolic links are not browsed."

msgid "아이디·비밀번호 또는 보안 문자를 확인하세요."
msgstr "Check your username, password or CAPTCHA."

msgid "알 수 없는 주제입니다."
msgstr "Unknown subject."

msgid "얼굴 미리보기 준비 중입니다."
msgstr "Preparing face preview."

msgid "얼굴을 찾을 수 없습니다."
msgstr "Face not found."

msgid "연결된 Live Photo 영상이 없습니다."
msgstr "No paired Live Photo video."

msgid "연결된 외장 드라이브 내부 폴더를 선택하세요."
msgstr "Choose a folder on a connected external drive."

msgid "영상 변환 실패 또는 시간 초과"
msgstr "Video conversion failed or timed out"

msgid "오디오를 읽을 수 없습니다."
msgstr "Could not read the audio."

msgid "올바른 오디오가 아닙니다."
msgstr "Invalid audio."

msgid "외장 드라이브 또는 폴더가 연결되지 않았습니다."
msgstr "The external drive or folder is disconnected."

msgid "외장 드라이브만 관리할 수 있습니다."
msgstr "Only external drives can be managed."

msgid "요청이 너무 큽니다."
msgstr "Request too large."

msgid "유지·재감지 시간은 0.3~60초, 실행 간격은 3~3600초입니다."
msgstr "Hold and rearm times must be 0.3–60 seconds; execution interval must be 3–3600 seconds."

msgid "음성 모델을 준비하고 있습니다."
msgstr "Preparing the speech model."

msgid "음성 처리 시간이 초과되었습니다."
msgstr "Speech processing timed out."

msgid "음성은 15초 이내로 녹음하세요."
msgstr "Keep recordings within 15 seconds."

msgid "음성을 인식하지 못했습니다. 다시 말씀해 주세요."
msgstr "Could not recognize speech. Please try again."

msgid "응답 생성을 중단했습니다."
msgstr "Response generation stopped."

msgid "이 명령은 허용된 기기 제어 목록에 없습니다."
msgstr "This command is not in the allowed device control list."

msgid "이 파일 또는 폴더를 읽을 권한이 없습니다."
msgstr "You do not have permission to read this file or folder."

msgid "이 폴더에 녹화 중입니다. 녹화 종료 후 해제하세요."
msgstr "Recording to this folder. Stop recording before removing it."

msgid "이미 녹화 중입니다."
msgstr "Already recording."

msgid "이미 사용한 OAuth 상태입니다."
msgstr "This OAuth state has already been used."

msgid "이미 사용한 로그인 연결입니다."
msgstr "This login link has already been used."

msgid "인가 코드가 없습니다."
msgstr "No authorization code received."

msgid "잘못된 감지 항목입니다."
msgstr "Invalid detection type."

msgid "잘못된 제스처 매핑"
msgstr "Invalid gesture mapping"

msgid "잘못된 페이지입니다."
msgstr "Invalid page."

msgid "잠시 후 새 보안 문자를 요청하세요."
msgstr "Wait before requesting another CAPTCHA."

msgid "저장된 SmartThings 인증을 읽을 수 없습니다. 다시 연결하세요."
msgstr "Could not read stored SmartThings credentials. Please reconnect."

msgid "접근 제외 경로입니다."
msgstr "Access to this path is excluded."

msgid "존재하는 Flow를 선택하세요."
msgstr "Choose an existing Flow."

msgid "지연은 0~60초입니다."
msgstr "Delays must be between 0 and 60 seconds."

msgid "지원하지 않는 Flow 단계입니다."
msgstr "Unsupported Flow step."

msgid "지원하지 않는 공유 작업입니다."
msgstr "Unsupported sharing operation."

msgid "카메라 종료 중입니다. 잠시 후 다시 켜세요."
msgstr "The camera is stopping. Try turning it on again shortly."

msgid "카메라를 먼저 켜세요."
msgstr "Turn on the camera first."

msgid "파일 또는 드라이브가 없습니다."
msgstr "File or drive not found."

msgid "파일 또는 폴더가 이동되었거나 삭제됐습니다."
msgstr "This file or folder was moved or deleted."

msgid "파일을 선택하세요."
msgstr "Choose a file."

msgid "파일을 찾을 수 없습니다."
msgstr "File not found."

msgid "폴더를 선택하세요."
msgstr "Choose a folder."

msgid "해당 파일 또는 폴더의 접근 권한이 없습니다."
msgstr "You do not have permission to access this file or folder."

msgid "허용 폴더 밖의 파일입니다."
msgstr "This file is outside the allowed folder."

msgid "회전은 0/90/180/270도, 반전은 켜기/끄기로 지정하세요."
msgstr "Rotation must be 0, 90, 180 or 270 degrees; flips must be on or off."

msgid "새 대화"
msgstr "New conversation"

msgid "무엇을 도와드릴까요?"
msgstr "How can I help?"

msgid "실행할 Flow를 확인해 주세요."
msgstr "Please confirm the Flow to run."

msgid "일치하는 Flow를 찾지 못했습니다."
msgstr "No matching Flow found."

msgid "연결된 기기 또는 실행할 동작을 확인할 수 없습니다."
msgstr "Could not identify a connected device or a supported action."

#, python-format
msgid "‘%(query)s’ 검색 결과 %(count)s개를 찾았습니다."
msgstr "Found %(count)s results for “%(query)s”."

#, python-format
msgid "‘%(query)s’에 해당하는 색인 결과가 없습니다. 검색어나 대상 폴더를 확인하세요."
msgstr "No indexed results for “%(query)s”. Check your query or registered folders."

#, python-format
msgid "%(name)s: %(command)s 명령을 확인해 주세요."
msgstr "Confirm %(command)s for %(name)s."

msgid "켜기"
msgstr "turn on"

msgid "끄기"
msgstr "turn off"

msgid "이름이 여러 얼굴 묶음과 일치합니다. 사진 관리에서 이름을 구분해 주세요."
msgstr "This name matches several face groups. Give them distinct names in Photos."

msgid "그 이름으로 저장된 얼굴 묶음이 없습니다. 사진 관리 → 사람들에서 먼저 이름을 붙여 주세요."
msgstr "No face group has that name. Name someone in Photos → People first."

msgid "촬영 시작일이 종료일보다 늦습니다. 날짜 범위를 확인해 주세요."
msgstr "The capture start date is after the end date. Check the range."

msgid "현재는 등록된 사람 이름·주제·촬영 날짜로 검색합니다. 사진 관리의 주제 또는 사람 이름을 지정해 주세요."
msgstr ""
"Search supports saved person names, subjects and capture dates. Choose a subject or saved person "
"name."

msgid "사진 보관함"
msgstr "Photo library"

msgid " 주제"
msgstr " subject"

#, python-format
msgid "%(condition)s에서 %(count)s개를 찾았습니다. 최대 8개를 표시합니다."
msgstr "Found %(count)s items in %(condition)s. Showing up to 8."

#, python-format
msgid "%(condition)s에 일치하는 처리된 사진이 없습니다. 색인 진행 상태와 이름·주제를 확인해 주세요."
msgstr "No processed photos match %(condition)s. Check indexing progress, names and subjects."

msgid "SmartThings 연결 완료"
msgstr "SmartThings connected"

msgid "SmartThings 연결이 취소되었습니다"
msgstr "SmartThings connection cancelled"

msgid "대시보드에서 기기 목록을 불러올 수 있습니다."
msgstr "You can now load your devices in the dashboard."

msgid "대시보드에서 다시 연결할 수 있습니다."
msgstr "You can reconnect from the dashboard."

msgid "Alter 대시보드로 돌아가기"
msgstr "Return to Alter"

msgid "응답을 생성하지 못했습니다. 다시 시도하세요."
msgstr "Could not generate a response. Please try again."

msgid "요청을 읽고 있습니다…"
msgstr "Reading your request…"

msgid "사람"
msgstr "People"

msgid "동물"
msgstr "Animals"

msgid "건물"
msgstr "Buildings"

msgid "서류"
msgstr "Documents"

msgid "문서"
msgstr "Documents"

msgid "카드"
msgstr "Cards"

msgid "음식"
msgstr "Food"

msgid "자연"
msgstr "Nature"

