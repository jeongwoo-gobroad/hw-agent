# Copy to .env. Never commit actual credentials.
DASHBOARD_USERNAME=change-me
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=replace-with-random-secret
DATA_DIR=./data
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_PAT=
SMARTTHINGS_REDIRECT_URI=
SMARTTHINGS_OAUTH_BASE=https://api.smartthings.com/oauth
DASHBOARD_URL=http://raspberrypi.local:11977
LLM_BASE_URL=http://127.0.0.1:8081
# Add your public IP/DDNS hostname here when forwarding port 8080.
ALLOWED_HOSTS=127.0.0.1,localhost,raspberrypi,raspberrypi.local
SECURE_COOKIE=false
NGROK_AUTHTOKEN=

# Comma-separated directory names excluded from browsing and indexing
EXCLUDED_DIRECTORY_NAMES=

# Login failure policy is stored in SQLite and edited in Settings > Security.

# Replace with your trusted LAN subnet before installation.
LAN_CIDR=192.168.1.0/24
